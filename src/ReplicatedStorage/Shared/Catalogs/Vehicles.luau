Vehicles.map = {}
for _, vehicleType in ipairs(Vehicles.list) do
	Vehicles.map[vehicleType.id] = vehicleType
end

function Vehicles.get(id: string): any?
	return Vehicles.map[id]
end

function Vehicles.exists(id: string): boolean
	return Vehicles.map[id] ~= nil
end

function Vehicles.label(id: string): string
	local vehicleType = Vehicles.map[id]
	return vehicleType and vehicleType.name or id
end

-- Types d'un service, triés par nom.
function Vehicles.orderInService(service: string): { any }
	local result = {}
	for _, vehicleType in ipairs(Vehicles.list) do
		if vehicleType.service == service then
			table.insert(result, vehicleType)
		end
	end
	table.sort(result, function(a, b)
		return a.name < b.name
	end)
	return result
end

return Vehicles
